// ECE:3350 SISC processor project
// Example data for the bubble sort program.
//
00000006 // :0  N = 6
00000005 // :1  List: [5, -2, 18, 10, 0, -7]
FFFFFFFE // :2
00000012 // :3  Expected memory contents after execution: [-7, -2, 0, 5, 10, 18]
0000000A // :4
00000000 // :5
FFFFFFF9 // :6

// Format 1: [31:28] Opcode | [27:24] MFF | [23:20] Rd | [19:16] Rs | [15:12] Rt | [11:0] Funct |
// Format 2: [31:28] Opcode | [27:24] MFF | [23:20] Rd | [19:16] Rs |     [15:0] Immediate      |
// Format 3: [31:28] Opcode | [27:24] CC  |          Unused         |     [15:0] Immediate      |

// Bubble sort psudocode
// N = Mem[0]
// for i = 1 to N-1:
//    for j = 1 to N-i:
//        if Mem[j] > Mem[j+1]: swap them

// 00: LDA  R1, R0, 0x0000    ; R1 = Mem[0] = N
A0100000

// 01: ADI  R2, R1, 0xFFFF    ; R2 = N-1 (outer loop limit)
2121FFFF

// 02: OUTER_TOP
//     ADI  R7, R2, 0x0000    ; copy R2→R7, sets Z flag if R2==0
21720000

// 03: BRA  (CC=Z)  0x0012    ; if R2==0, we're done
41000012

// 04: ADI  R3, R0, 0x0001    ; j = 1 (inner index starts at 1)
21300001

// 05: INNER_TOP
//     SUB  R7, R2, R3        ; R7 = R2 - j; N flag set if j > R2
12723000

// 06: BRA  (CC=N)  0x0010    ; if j > R2, inner loop done
42000010

// 07: LDX  R4, R3, 0x0000    ; R4 = Mem[j]
A8430000

// 08: ADI  R6, R3, 0x0001    ; R6 = j+1
21630001

// 09: LDX  R5, R6, 0x0000    ; R5 = Mem[j+1]
A8560000

// 0A: SUB  R7, R4, R5        ; R7 = R4 - R5
12745000

// 0B: BRA  (CC=N|Z) 0x000E   ; if R4 <= R5, skip swap (N or Z → already sorted)
4300000E

// 0C: STX  R5, R3, 0x0000    ; SWAP: Mem[j]   = R5 (the smaller value)
B8530000

// 0D: STX  R4, R6, 0x0000    ;       Mem[j+1] = R4 (the larger value)
B8460000

// 0E: NO_SWAP
//     ADI  R3, R3, 0x0001    ; j++
21330001

// 0F: BNR  (CC=0, unc) -11   ; unconditional jump back to INNER_TOP (0x05)
7000FFF5

// 10: INNER_DONE
//     ADI  R2, R2, 0xFFFF    ; R2-- (next pass has one fewer comparison)
2122FFFF

// 11: BNR  (CC=0, unc) -16   ; unconditional jump back to OUTER_TOP (0x02)
7000FFF0

// 12: DONE
//     HLT
F0000000

