// ECE:3350 SISC processor project
// Bubble Sort instruction memory
//
// ISA Reference (from spec):
//   Format 1: [opcode(4)|MFF(4)|Rd(4)|Rs(4)|Rt(4)|000000000000]  -- REG_OP
//   Format 2: [opcode(4)|MFF(4)|Rd(4)|Rs(4)|imm(16)]             -- REG_IM / LOD / STR
//   Format 3: [opcode(4)|CC(4) |unused(8)  |target(16)]          -- branches
//
//   REG_OP opcodes (op=0x1), MFF = funct:
//     ADD=0x1, SUB=0x2, ADC=0x3, NOT=0x4, OR=0x5, AND=0x6, XOR=0x7
//     ROR=0x8, ROL=0x9, SHR=0xA, SHL=0xB, RRC=0xC, RLC=0xD, ASR=0xE, ASL=0xF
//
//   REG_IM opcodes (op=0x2), MFF = funct:
//     ADI=0x1, SBI=0x2, ACI=0x3, NTI=0x4, ORI=0x5, ANI=0x6, XRI=0x7
//     RORI=0x8, ROLI=0x9, SHRI=0xA, SHLI=0xB, RRCI=0xC, RLCI=0xD, ASRI=0xE, ASLI=0xF
//
//   Load/Store (op=0xA / 0xB):
//     LDA: op=A MFF=0  Rd<-Mem[imm]
//     LDX: op=A MFF=8  Rd<-Mem[Rs+imm]
//     STA: op=B MFF=0  Mem[imm]<-Rd
//     STX: op=B MFF=8  Mem[Rs+imm]<-Rd
//
//   Branches (op=0x4..0x7):
//     BRA: branch if (CC & stat) != 0
//     BNE: branch if (CC & stat) == 0  -- BNE CC=0000 is UNCONDITIONAL
//
//   stat bits: [3]=C  [2]=V  [1]=N  [0]=Z
//
// Pseudo-instructions used:
//   LRI Rd, imm  =>  ADI Rd, R0, imm   (load register with sign-extended immediate)
//   CLR Rd       =>  ADD Rd, R0, R0    (clear register to 0)
//   INC Rd       =>  ADI Rd, Rd, 1
//   DEC Rd       =>  ADI Rd, Rd, 0xFFFF
//
// Register assignments:
//   R0  = 0 (never written)
//   R1  = N (array length, from Mem[0])
//   R2  = outer bound (starts N-1, decremented each outer pass)
//   R3  = j, inner loop index
//   R4  = arr[j],   loaded from Mem[R5+0]
//   R5  = address of arr[j]   = j + 1  (base 1, since arr starts at Mem[1])
//   R6  = arr[j+1], loaded from Mem[R5+1]
//   R7  = scratch for comparisons / temp
//
// Algorithm:
//   R1 = Mem[0]       (N)
//   R2 = N - 1        (outer bound)
//   outer: if R2 == 0 goto done
//     R3 = 0          (j = 0)
//     inner: if R3 >= R2 goto outer_end
//       R5 = R3 + 1               (address of arr[j])
//       R4 = Mem[R5 + 0]          (arr[j])
//       R6 = Mem[R5 + 1]          (arr[j+1])
//       R7 = R4 - R6
//       if R7 <= 0 goto no_swap   (arr[j] <= arr[j+1], already ordered)
//       Mem[R5 + 0] = R6          (swap)
//       Mem[R5 + 1] = R4
//       no_swap:
//       R3 = R3 + 1               (j++)
//       goto inner
//     outer_end:
//     R2 = R2 - 1
//     goto outer
//   done: HLT
//
// ---- Program ----
//
// :00  R1 = Mem[0]    -- LDA R1, 0 : load N
//      op=A MFF=0 Rd=1 Rs=0 imm=0000
//      1010 0000 0001 0000 0000000000000000
A0100000
//
// :01  R2 = R1 - 1    -- SBI R2, R1, 1 : outer bound = N-1
//      op=2 MFF=2 Rd=2 Rs=1 imm=0001
//      0010 0010 0010 0001 0000000000000001
22210001
//
// OUTER LOOP CHECK: :02
// :02  R7 = R2 - R2   sets Z if R2==0... better: compare R2 directly.
//      Use: R7 = R0 - R2 via SUB; if Z set (R2==0) branch to HLT
//      SUB R7, R0, R2 => op=1 MFF=2 Rd=7 Rs=0 Rt=2
//      0001 0010 0111 0000 0010 000000000000
12702000
//
// :03  BRA if Z set (R2==0) => done. Jump to :12 (HLT)
//      stat[0]=Z. CC=0001 => branch if Z set.
//      BRA op=4 CC=0001 target=0012
//      0100 0001 0000 0000 0000000000010010
41000012
//
// :04  R3 = 0          -- CLR R3 : j = 0
//      ADD R3, R0, R0 => op=1 MFF=1 Rd=3 Rs=0 Rt=0
//      0001 0001 0011 0000 0000 000000000000
11300000
//
// INNER LOOP CHECK: :05
// :05  R7 = R2 - R3    -- compare outer bound vs j; Z set if R3==R2
//      SUB R7, R2, R3 => op=1 MFF=2 Rd=7 Rs=2 Rt=3
//      0001 0010 0111 0010 0011 000000000000
12723000
//
// :06  BRA if Z set (j==R2) => inner loop done, jump to outer_end :10
//      BRA CC=0001 target=0010
//      0100 0001 0000 0000 0000000000010000
41000010
//
// :07  R5 = R3 + 1     -- address of arr[j] = j + 1
//      ADI R5, R3, 1 => op=2 MFF=1 Rd=5 Rs=3 imm=0001
//      0010 0001 0101 0011 0000000000000001
21530001
//
// :08  R4 = Mem[R5+0]  -- load arr[j]
//      LDX R4, R5, 0 => op=A MFF=8 Rd=4 Rs=5 imm=0000
//      1010 1000 0100 0101 0000000000000000
A8450000
//
// :09  R6 = Mem[R5+1]  -- load arr[j+1]
//      LDX R6, R5, 1 => op=A MFF=8 Rd=6 Rs=5 imm=0001
//      1010 1000 0110 0101 0000000000000001
A8650001
//
// :0A  R7 = R4 - R6    -- compare arr[j] vs arr[j+1]
//      N set (stat[1]) if result negative => arr[j] < arr[j+1] => in order
//      Z set (stat[0]) if equal => in order
//      SUB R7, R4, R6 => op=1 MFF=2 Rd=7 Rs=4 Rt=6
//      0001 0010 0111 0100 0110 000000000000
12746000
//
// :0B  BRA if N set OR Z set (arr[j] <= arr[j+1]) => no swap, jump to :0E
//      CC=0011 (bits for N=bit1 and Z=bit0)
//      stat[1]=N, stat[0]=Z => CC=0011 tests both
//      BRA CC=0011 target=000E
//      0100 0011 0000 0000 0000000000001110
4300000E
//
// SWAP:
// :0C  Mem[R5+0] = R6  -- write arr[j+1] value into arr[j] slot
//      STX R6, R5, 0 => op=B MFF=8 Rd=6 Rs=5 imm=0000
//      1011 1000 0110 0101 0000000000000000
B8650000
//
// :0D  Mem[R5+1] = R4  -- write arr[j] value into arr[j+1] slot
//      STX R4, R5, 1 => op=B MFF=8 Rd=4 Rs=5 imm=0001
//      1011 1000 0100 0101 0000000000000001
B8450001
//
// :0E  R3 = R3 + 1     -- j++
//      ADI R3, R3, 1 => op=2 MFF=1 Rd=3 Rs=3 imm=0001
//      0010 0001 0011 0011 0000000000000001
21330001
//
// :0F  jump back to inner loop check at :05
//      BNE CC=0000 (unconditional) target=0005
//      0110 0000 0000 0000 0000000000000101
60000005
//
// outer_end: :10
// :10  R2 = R2 - 1     -- DEC R2
//      ADI R2, R2, 0xFFFF => op=2 MFF=1 Rd=2 Rs=2 imm=FFFF
//      0010 0001 0010 0010 1111111111111111
2122FFFF
//
// :11  jump back to outer loop check at :02
//      BNE CC=0000 (unconditional) target=0002
//      0110 0000 0000 0000 0000000000000010
60000002
//
// :12  HLT
F0000000