// ECE:3350 SISC processor project
// 32x32 -> 64-bit unsigned multiplication (shift-and-add algorithm)
//
// Instruction encodings:
//   REG_OP (op=1): [0001|mff[3:0]|rd[3:0]|rs[3:0]|rt[3:0]|00000000|funct[3:0]]
//   REG_IM (op=2): [0010|mff[3:0]|rd[3:0]|rs[3:0]|imm[15:0]]
//   LOD    (op=A): [1010|mff[3:0]|rd[3:0]|rs[3:0]|imm[15:0]]
//   STR    (op=B): [1011|mff[3:0]|rt[3:0]|rs[3:0]|imm[15:0]]
//   BRA    (op=4): [0100|mm[3:0] |0000   |0000   |target[15:0]]
//   BNE    (op=6): [0110|mm[3:0] |0000   |0000   |target[15:0]]
//   HLT    (op=F): [1111|0000|0000|0000|0000000000000000]
//
// ALU funct (REG_OP): ADD=0, SUB=1, AND=2, OR=3, XOR=4, NOT=5, LSL=6, LSR=7
// stat: [3]=C [2]=N [1]=Z [0]=V
//
// Algorithm: standard shift-and-add for unsigned 32x32->64 multiplication.
//   result_lo = 0, result_hi = 0
//   For i = 0 to 31:
//     if LSB of B is 1: result_hi += A  (carry tracked separately)
//     shift A left by 1 (A_hi:A_lo <<= 1)
//     shift B right by 1
//
// Register assignments:
//   R0  = 0  (always zero)
//   R1  = A  (multiplicand, from mem[0])
//   R2  = B  (multiplier,   from mem[1])
//   R3  = result_lo (low  32 bits of product)
//   R4  = result_hi (high 32 bits of product)
//   R5  = loop counter (32 iterations)
//   R6  = scratch / bit test
//   R7  = constant 1
//   R8  = carry from result_lo addition (isolated)
//   R9  = A_hi (high word of shifted A, starts 0)
//
// Memory layout (mult_data.data):
//   mem[0] = A = 87654321
//   mem[1] = B = 789ABCDE
//   mem[2] = result LS word  (write here)
//   mem[3] = result MS word  (write here)
//
// Expected result: A*B = 3FC94E45_A0F6729E
//   mem[2] = A0F6729E  (low)
//   mem[3] = 3FC94E45  (high)
//
// ---- Program ----
//
// :00  R1 = mem[0]  -- load A
//      LOD R1, R0, 0  =>  1010|0000|0001|0000|0000000000000000
A0100000
// :01  R2 = mem[1]  -- load B
//      LOD R2, R0, 1  =>  1010|0000|0010|0000|0000000000000001
A0200001
// :02  R3 = 0       -- result_lo = 0
//      REG_IM R3, R0, 0  =>  0010|0000|0011|0000|0000000000000000
20300000
// :03  R4 = 0       -- result_hi = 0
//      REG_IM R4, R0, 0  =>  0010|0000|0100|0000|0000000000000000
20400000
// :04  R9 = 0       -- A_hi = 0
//      REG_IM R9, R0, 0  =>  0010|0000|1001|0000|0000000000000000
20900000
// :05  R7 = 1       -- constant 1
//      REG_IM R7, R0, 1  =>  0010|0000|0111|0000|0000000000000001
20700001
// :06  R5 = 32      -- loop count = 32 (0x0020)
//      REG_IM R5, R0, 32  =>  0010|0000|0101|0000|0000000000100000
20500020
//
// LOOP starts at :07
// :07  R6 = R2 AND R7   -- isolate LSB of B
//      REG_OP R6, R2, R7, AND  =>  0001|0000|0110|0010|0111|00000000|0010
10627002
// :08  BNE if Z set (LSB==0) => skip addition; jump to :0D
//      BNE mm=0010 (Z bit), target=000D
//      0110|0010|0000|0000|0000000000001101
6200000D
//
// LSB of B is 1: add A_lo to result_lo, add A_hi + carry to result_hi
// :09  R3 = R3 + R1   -- result_lo += A_lo  (stat[3]=C gets carry out)
//      REG_OP R3, R3, R1, ADD  =>  0001|0000|0011|0011|0001|00000000|0000
10331000
// :0A  R8 = 0         -- prepare carry = 0
//      REG_IM R8, R0, 0  =>  0010|0000|1000|0000|0000000000000000
20800000
// :0B  BNE if C clear (no carry) => skip carry increment; jump to :0D
//      BRA mm=1000 (C bit), target=000D  -- branch IF carry SET
//      0100|1000|0000|0000|0000000000001101
4800000D
// :0C  R8 = R7        -- carry = 1
//      REG_IM R8, R0, 1  =>  0010|0000|1000|0000|0000000000000001
20800001
// :0D  R4 = R4 + R9   -- result_hi += A_hi
//      REG_OP R4, R4, R9, ADD  =>  0001|0000|0100|0100|1001|00000000|0000
10449000
// :0E  R4 = R4 + R8   -- result_hi += carry from lo addition
//      REG_OP R4, R4, R8, ADD  =>  0001|0000|0100|0100|1000|00000000|0000
10448000
//
// Shift A left by 1: A_hi = (A_hi << 1) | MSB(A_lo);  A_lo = A_lo << 1
// :0F  R6 = R1 LSR 31  -- extract MSB of A_lo into bit 0
//      REG_OP R6, R1, R0, LSR with imm shift? Use REG_IM form:
//      REG_IM R6, R1, 31 with alu_op LSR -- but REG_IM uses alu_op=0011 (stage)
//      Actually use REG_OP with funct=LSR(7), rt field = shift amount reg.
//      We need shift-by-31; store 31 in a register first.
//      REG_IM R6, R0, 31  =>  0010|0000|0110|0000|0000000000011111
2060001F
// :10  R6 = R1 LSR R6  -- R6 = A >> 31 (MSB of A in bit 0)
//      REG_OP R6, R1, R6, LSR  =>  0001|0000|0110|0001|0110|00000000|0111
10616007
// :11  R9 = R9 LSL R7  -- A_hi <<= 1
//      REG_OP R9, R9, R7, LSL  =>  0001|0000|1001|1001|0111|00000000|0110
10997006
// :12  R9 = R9 OR R6   -- A_hi |= MSB of old A_lo
//      REG_OP R9, R9, R6, OR   =>  0001|0000|1001|1001|0110|00000000|0011
10996003
// :13  R1 = R1 LSL R7  -- A_lo <<= 1
//      REG_OP R1, R1, R7, LSL  =>  0001|0000|0001|0001|0111|00000000|0110
10117006
//
// Shift B right by 1
// :14  R2 = R2 LSR R7  -- B >>= 1
//      REG_OP R2, R2, R7, LSR  =>  0001|0000|0010|0010|0111|00000000|0111
10227007
//
// Decrement counter and loop
// :15  R5 = R5 - R7    -- counter--
//      REG_OP R5, R5, R7, SUB  =>  0001|0000|0101|0101|0111|00000000|0001
10557001
// :16  R6 = R5 - R0    -- test R5 == 0 (sets Z)
//      REG_OP R6, R5, R0, SUB  =>  0001|0000|0110|0101|0000|00000000|0001
10650001
// :17  BNE if Z clear (counter != 0) => loop back to :07
//      BNE mm=0010, target=0007
//      0110|0010|0000|0000|0000000000000111
62000007
//
// Store 64-bit result
// :18  STR result_lo (R3) -> mem[R0 + 2]
//      STR R3, R0, 2  =>  1011|0000|0011|0000|0000000000000010
B0300002
// :19  STR result_hi (R4) -> mem[R0 + 3]
//      STR R4, R0, 3  =>  1011|0000|0100|0000|0000000000000011
B0400003
//
// :1A  HLT
F0000000