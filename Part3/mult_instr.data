// ECE:3350 SISC processor project
// 32x32 -> 64-bit unsigned multiplication (shift-and-add)
//
// ISA Reference:
//   LDA Rd, imm       : op=A MFF=0  Rd <- Mem[imm]
//   STA Rd, imm       : op=B MFF=0  Mem[imm] <- Rd
//   ADI Rd, Rs, imm   : op=2 MFF=1  Rd <- Rs + sign_ext(imm)
//   ADD Rd, Rs, Rt    : op=1 MFF=1  Rd <- Rs + Rt
//   SUB Rd, Rs, Rt    : op=1 MFF=2  Rd <- Rs - Rt
//   ANI Rd, Rs, imm   : op=2 MFF=6  Rd <- Rs AND zero_ext(imm)
//   SHRI Rd, Rs, imm  : op=2 MFF=A  Rd <- Rs >> imm[4:0]  (logical)
//   SHLI Rd, Rs, imm  : op=2 MFF=B  Rd <- Rs << imm[4:0]
//   BRA CC target     : op=4  branch if (CC & stat) != 0
//   BNE CC target     : op=6  branch if (CC & stat) == 0; CC=0000 => unconditional
//   HLT               : op=F
//
//   stat bits: [3]=C  [2]=V  [1]=N  [0]=Z
//
// Algorithm: shift-and-add, LSB-first, 32 iterations.
//
//   Carry detection: instead of relying on the C flag across instructions,
//   we detect carry from (result_lo + A) by checking if result_lo wrapped
//   around, i.e. if the new result_lo < old result_lo (unsigned).
//   This is equivalent to: carry = (new_R3 < R1) after R3 = R3 + R1,
//   which we test as: SUB R7, R3, R8  where R8 = old result_lo saved before add.
//   If the subtraction is negative (N set), then R3 < R8, meaning carry occurred.
//
// Register assignments:
//   R0  = 0 (never written)
//   R1  = A (multiplicand, left-shifted each iter)
//   R2  = B (multiplier,   right-shifted each iter)
//   R3  = result_lo
//   R4  = result_hi
//   R5  = loop counter (32 down to 1)
//   R6  = scratch (LSB test)
//   R7  = scratch (carry detect)
//   R8  = saved result_lo before addition (for carry detection)
//
// Memory layout (mult_data.data):
//   Mem[0] = A = 0x87654321
//   Mem[1] = B = 0x789ABCDE
//   Mem[2] = result LS word  (expected: 0xA0F6729E)
//   Mem[3] = result MS word  (expected: 0x3FC94E45)
//
// ---- Program ----
//
// :00  R1 = Mem[0]     -- LDA R1, 0 : load A
//      op=A MFF=0 Rd=1 Rs=0 imm=0000
//      1010 0000 0001 0000 0000000000000000
A0100000
//
// :01  R2 = Mem[1]     -- LDA R2, 1 : load B
//      op=A MFF=0 Rd=2 Rs=0 imm=0001
//      1010 0000 0010 0000 0000000000000001
A0200001
//
// :02  R3 = 0          -- CLR R3 : result_lo = 0
//      ADD R3, R0, R0 => op=1 MFF=1 Rd=3 Rs=0 Rt=0
//      0001 0001 0011 0000 0000 000000000000
11300000
//
// :03  R4 = 0          -- CLR R4 : result_hi = 0
//      ADD R4, R0, R0 => op=1 MFF=1 Rd=4 Rs=0 Rt=0
//      0001 0001 0100 0000 0000 000000000000
11400000
//
// :04  R5 = 32         -- LRI R5, 32 : loop counter
//      ADI R5, R0, 32 => op=2 MFF=1 Rd=5 Rs=0 imm=0020
//      0010 0001 0101 0000 0000000000100000
21500020
//
// LOOP: :05
// :05  R6 = R2 AND 1   -- isolate LSB of B
//      ANI R6, R2, 1 => op=2 MFF=6 Rd=6 Rs=2 imm=0001
//      0010 0110 0110 0010 0000000000000001
26620001
//
// :06  BRA if Z set (LSB==0) => skip addition, jump to :0B
//      ANI sets Z (stat[0]) when result is zero (LSB was 0).
//      BRA CC=0001 target=000B
//      0100 0001 0000 0000 0000000000001011
4100000B
//
// LSB of B is 1: add A into accumulator with explicit carry detection
// :07  R8 = R3         -- save result_lo before addition (for carry detect)
//      ADD R8, R3, R0 => op=1 MFF=1 Rd=8 Rs=3 Rt=0
//      0001 0001 1000 0011 0000 000000000000
11830000
//
// :08  R3 = R3 + R1    -- result_lo += A
//      ADD R3, R3, R1 => op=1 MFF=1 Rd=3 Rs=3 Rt=1
//      0001 0001 0011 0011 0001 000000000000
11331000
//
// :09  R7 = R3 - R8    -- carry detection: if R3 < R8 then carry occurred
//      SUB R7, R3, R8 => op=1 MFF=2 Rd=7 Rs=3 Rt=8
//      0001 0010 0111 0011 1000 000000000000
12738000
//
// :0A  BNE if N clear (no carry, R3 >= R8) => skip carry add, jump to :0C
//      N = stat[1]. BNE CC=0010 branches when N is NOT set.
//      BNE CC=0010 target=000C
//      0110 0010 0000 0000 0000000000001100
6200000C
//
// carry occurred: R4++
// :0B  R4 = R4 + 1     -- result_hi += 1 (carry)  [also reached via fall-through from :0A]
//      ADI R4, R4, 1 => op=2 MFF=1 Rd=4 Rs=4 imm=0001
//      0010 0001 0100 0100 0000000000000001
21440001
//
// :0C  R2 = R2 >> 1    -- B >>= 1 (logical shift right, next bit of B)
//      SHRI R2, R2, 1 => op=2 MFF=A Rd=2 Rs=2 imm=0001
//      0010 1010 0010 0010 0000000000000001
2A220001
//
// :0D  R1 = R1 << 1    -- A <<= 1
//      SHLI R1, R1, 1 => op=2 MFF=B Rd=1 Rs=1 imm=0001
//      0010 1011 0001 0001 0000000000000001
2B110001
//
// :0E  R5 = R5 - 1     -- counter--
//      ADI R5, R5, 0xFFFF (DEC) => op=2 MFF=1 Rd=5 Rs=5 imm=FFFF
//      0010 0001 0101 0101 1111111111111111
2155FFFF
//
// :0F  BNE if Z clear (counter != 0) => loop back to :05
//      DEC sets Z (stat[0]) when R5 reaches 0.
//      BNE CC=0001 target=0005
//      0110 0001 0000 0000 0000000000000101
61000005
//
// Store results
// :10  Mem[2] = R3     -- STA R3, 2 : store result_lo
//      op=B MFF=0 Rd=3 Rs=0 imm=0002
//      1011 0000 0011 0000 0000000000000010
B0300002
//
// :11  Mem[3] = R4     -- STA R4, 3 : store result_hi
//      op=B MFF=0 Rd=4 Rs=0 imm=0003
//      1011 0000 0100 0000 0000000000000011
B0400003
//
// :12  HLT
F0000000